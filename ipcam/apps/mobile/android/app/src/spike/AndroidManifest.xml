<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SPIKE-ONLY (plan 2026-10-18-phase0b-video-spike, Task 10): MV4 holds a
         1-pixel camera capture so that the WebView reports which decoder it uses. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- SPIKE-ONLY (post-release task A): the automatic run vibrates the phone to call
         the person to S5 and S6. A normal permission: Android grants it at install. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- SPIKE-ONLY (owner's request of 2026-11-23): the app installs the APK of a newer
         release (SpikeUpdate.kt). Android still asks the person to allow it once
         («Install unknown apps») and to confirm every install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
