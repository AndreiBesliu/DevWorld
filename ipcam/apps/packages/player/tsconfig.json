{
  // The package ships TypeScript source (package.json "exports"): its consumers,
  // Vite builds, compile it. So nothing here emits and the base's `noEmit` stays.
  // The base's DOM lib stays too, because the player drives an HTMLVideoElement.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // TypeScript 6 loads no @types package unless it is listed. Node's types are
    // here for the tests (the lint fixture test uses node:path); listing only
    // them keeps other @types packages from adding globals to the sources.
    "types": ["node"]
  },
  "include": ["src"]
}
