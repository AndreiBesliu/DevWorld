{
  // The shipped sources. The package ships TypeScript source (package.json
  // "exports"): its consumers, Vite builds, compile it. So nothing here emits
  // and the base's `noEmit` stays. The base's DOM lib stays too, because the
  // player drives an HTMLVideoElement.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // TypeScript 6 loads no @types package unless it is listed, and none is:
    // these sources run in a browser, so `process` or `Buffer` must not
    // typecheck in them. The tests get Node's types from tsconfig.test.json.
    "types": []
  },
  "include": ["src"],
  // The tests and their doubles import vitest, which pulls in Node's types.
  "exclude": ["src/**/*.test.ts", "src/fakes.ts", "src/harness.ts"]
}
