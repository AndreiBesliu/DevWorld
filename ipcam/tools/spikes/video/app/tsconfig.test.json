{
  // The sources together with their tests (which read band/vectors.json through
  // node:fs) and the Vite config. Only this program sees Node's types;
  // tsconfig.json checks the shipped sources without them. `typecheck` runs both.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src", "vite.config.ts"],
  "exclude": []
}
